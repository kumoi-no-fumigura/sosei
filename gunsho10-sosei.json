 "poems": [
  {
   "seq": "1",
   "text": "春たては花とやみらん白雪のかゝれる枝に鶯のなく",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "よそにのみ哀とそ見し梅花あかぬ色かは折てえけり",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "散とみて有へき物を梅の花うたて匂ひの袖にとまれる",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "梅の花折はこほるゝ我袖に匂ひは移れ家つとにせん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "見てのみや人にかたらん櫻花手每に折て家つとにせん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "見渡せは柳櫻をこきませて都そ春の錦んける",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "まてといふにちらてしとまる物ならは何を櫻に思まさまし",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "花散らす風のやとりは誰かふる我にをしへよ行て恨みん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "櫻花ちくさなからにあたなれと誰かは春を恨みなれたる",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "花の木は今はほり植し春立ほうつろふ色に人ならひけり",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いさけふは春の山へにましりなむ暮なはなけの花の陰かは",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "いつ迄か野へに心のあくかれん花し散らすは千世もへぬへし",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "音にのみ菊のふら露よるは置てひるは思ひにたえすけぬへし",
   "kana": "",
   "speaker": "素性法師集",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "秋風の身に寒けれはつれもなき人をそ賴む暮る夜とに",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "はかなくて夢にも人をみつるよは朝の床そおきうかりける",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "今こんといひし計に長月の在明の月をまち出つる哉",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "秋風に山の木葉も色つけは人のこゝろもうたかはれけり",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "そこひなきふちやはさはく山河の淺き瀨に〓そうは浪はたて",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "便りなくなき名は沖に漕出なんよろへたもとに見るかひもなし",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "思ふともかれなん人をいかにせむあかす散ぬる花とこそ見め",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "忘れ草何をかたねと思ひしにつれなき人の心なりけり",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "山田すき春のたねをはまきしかと秋立身にはならしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "あふ事のかたの涙に袖朽め海士のたく火ば胸にもゆれと",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "植て見る松と竹とに君か代の千年ゆきかふ色もかはらす",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "別なは後忍へとそうつせみのよをあひかたみせめていはまし",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "鋪妙の枕にたにもふさはこそ夢の玉しひ下にかよはめ",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "山吹の花色衣ぬしやたれとへとこたへす口なしにして",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "手向にはつゝりの袖もきるへきに紅葉にあける神やかへさん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "いつくにか世をはつくさむ心こそ野にも山にも惑ふへらなれ",
   "kana": "",
   "speaker": "素性法師集",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "吹風にあつらへつくる物ならは此一枝はよきよといはまし",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "春日野に若菜摘つゝ萬代をいのる心は神そふるらん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "我のみやあはれと思はむきり〓〓す鳴ゆふ陰のやまと撫子",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "今宵こん人にはあはし七夕の久しき程にあへもこそすれ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "木つたへはをのか羽風に散花を誰におほせてこゝら鳴らん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "をこと思ふ心は糸によられなん散花每にぬきてとゝめん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "思ふとち春の山へに打むれてそこともふらぬ旅ねしてしが",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "子規鳴こゑ聞はあちきなくぬしさたまらぬ戀せらるはた",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "石上ふるき都の時鳥聲はかりこそむかし之けり",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "主知ぬ香こそ匂へれ秋の野に誰ぬきかけし藤はかまそも",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "かゝみ山やまかき曇りしくるれど紅葉あかくそ秋は見たげる",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "望月の駒よりをそく出つれはたとる〓〓そ山はこえつる",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "あふ事のかたみをたにもえてし哉人はたゆとも見つゝ忍はん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "いさ櫻我も散なむ一と盛ありへは人にうきめ見えなん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "いにしへにありきあらすはゑらねとも千年のためし君に初む",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "ふして思ひおきてかそふる萬代は神そふるらむ我君の爲",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "此御幸ちとせかへてもあらせなむかゝる山ふし時にあふへく",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "音にきく松か浦島けふそみる諾も心あるあまは住はり",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "紅葉はの流てとまる湊にはくれなゐ深き浪や立らん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "夕暮は匂ふ草木のなけれはや散と見えにし紅葉とまれる",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "山守はいはゝいはなむ高砂のをのへの櫻折てかさゝん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "打たのむ人の心のつらけれは野にも山にもいさかくれなん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "つらしとてもろはの山に隱なは我山ひこになきて恨みん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "尋れは杉のゝこえて三輪山の末〓〓まつそ生そはりける",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "杉山の水はかすともおもほえす戀しき君にゑき浪そ立",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "音にのみならしの岡のさねかつら人ゑれす社くらまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "君か爲我やはつらきから衣かけてないひそいひかたき〓と",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "浦にやくもにすみつゝそ燃え渡る海士のすさひに苅るみるめは",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "錨おろす舟のつなては遲くとも命のかきりたえしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "獨ねはいかなる人か戀はする見つけてけるも煙もそ立",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "なにしかも袖のぬれけむ白浪のなこり有ても見えぬ心を",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いたつらに立歸りにし白浪のなこりの袖のひる時そなき",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "いつかたによるとか志らむ靑柳のいと定なき人のこゝろを",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "山吹のはなの盛りは過にしをかへす〓〓も鳴かはつかな",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "思ふとち折て暮さむ岩つゝしいはぬ事をしいひ盡とも",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "春たにもありし心を夏衣いかにうつせのけふまさるらん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "惜めともとまらぬ春もある物をいはぬにきたる夏衣哉",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "きのふよりかはれる事もなけれともけふよりやまの秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "いかほのやいかほの沼のいかにして戀しき人を今一めみむ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "おほつかなたれ島山と思ふにもをしのひしきもかはらさり鳬",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "見め人を心ひとつに尋れとまたしらすこそ戀しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "思ひやり心にかなふ物ならは一日にちたひ君を見てまし",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "岩のうへに養の衣はうしろめた戀の涙はもらすもあらなん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "逢みてはゑにせぬ身とそ成ぬへき賴むるにたにのふる命を",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "君により我身そつらき玉たれのみすはつらしと思はましやは",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "梅かえのくつるはかりにあらす共よそにも折てよを明さはや",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "戀しきを思ひみたるゝ世中にふかき夢路をうつゝともかな",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "稀なれはゆゝしと思ひし七夕にけふは劣れる身ないかヽせん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "戀しさのなくさむ宵の明さらはしはしは物を思はさらまし",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "あふみのや深まのいねを苅つめて君か千年のありかすにせん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "浪まよりおほくら山に積いれの積とも盡し君か千年は",
   "kana": "",
   "speaker": "を",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "秋山にまとふ心を山河の瀧のまらあはにけちやはてゝむ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "萬代を松にそ君をいはひつる千年のかけにすまむと思へは",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "紅葉はは袖にこき入てもて出なん秋はかきりと見ん人の爲",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "ぬれてほす山路の菊の露のまにいかてか我はちよを經ぬらん",
   "kana": "",
   "speaker": "素性法師集",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "雨ふらは紅葉のかけにかくれつゝ立田の山にかくれはてなん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "雲と見えて日をまとはすはなかれ出て瀧の門より消る水かも",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "山をのみあはれ〓〓と見てくれは鳴ひくらしの聲そかなしき",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "山闇したひの雲の間雁金のらうたにもあるかすみかゝはるも",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "旅に出てせしことの葉にいひしかとよしより思へ心くたけぬ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "雨よりも袂なき身となりぬへしたえぬ淚にくちぬへけれは",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "白雪と身はふりぬともあたらしき春にあふ··そ嬉しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "春とのみ風はこしかとはかなくて老そしにける岸の姫松",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "秋風の吹上の濵の白菊は浪のよするか花の咲るか",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "人すます荒たるやときてみれは今そ木葉は錦也げる",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "神無月ふくれにそひて古〓は紅葉の色もこさまさりける",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "みな人の昔語りに成行に布留の社の身をいかにせむ",
   "kana": "",
   "speaker": "惠慶法師集",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "いつれをか雨ともわかん山伏のおつる淚も夜はにこそふる",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "山高み雲井にみゆる櫻花心の行て折ぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "めつらしき聲ならなくに子規こゝらの年をあかすも有哉",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "住の江の松を吹風秋からに聲打そふる沖つ白浪",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "千鳥鳴さほの河霧立ぬらし山の木葉も色まさサ行",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "秋くれと色もかはらぬときは山餘所の紅葉を風そかしける",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "白雪の降しく時はみよし野の山下風に花そ散ける",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "ちの涙落てそたきつ白河は君か世まての名にこそ有けれ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "秋の田のいねてふ〓ともかけなくに何をうしとか人の苅らん",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  }
